#! /bin/bash

# COLORS
export OFF='\033[0m'
export RED='\033[0;31m'
export GREEN='\033[0;32m'
export BLUE='\033[0;34m'
export PURPLE='\033[0;35m'

APPLICATION_ROOTS=("/Applications" "$HOME/Applications")

print_info() { printf "%s\n" "$1"; }
print_warn() { printf "%b%s%b\n" "$PURPLE" "$1" "$OFF"; }
print_error() { printf "%b%s%b\n" "$RED" "$1" "$OFF"; }
print_success() { printf "%b%s%b\n" "$GREEN" "$1" "$OFF"; }
print_prompt() { printf "%b%s%b" "$PURPLE" "$1" "$OFF"; }
print_header() { printf "%b%s%b\n" "$BLUE" "$1" "$OFF"; }

discover_applications() {
  local root app

  for root in "$@"; do
    [ -d "$root" ] || continue

    while IFS= read -r -d '' app; do
      [ -e "$app/Contents/Info.plist" ] || continue
      printf "%s\n" "$app"
    done < <(find "$root" -mindepth 1 -maxdepth 2 \( -type d -o -type l \) -name "*.app" -prune -print0 2> /dev/null)
  done | LC_ALL=C sort -fu
}

print_installed_applications() {
  local app
  local applications=()

  while IFS= read -r app; do
    [ -n "$app" ] && applications+=("$app")
  done < <(discover_applications "$@")

  print_header "Installed applications"
  if [ ${#applications[@]} -eq 0 ]; then
    print_warn "No applications found."
  else
    for app in "${applications[@]}"; do
      printf "%s\n" "$app"
    done
  fi
  print_info "Total: ${#applications[@]}"
}

lowercase() {
  printf "%s" "$1" | tr '[:upper:]' '[:lower:]'
}

resolve_application() {
  local query query_lower app app_name app_name_lower
  local exact_matches=()
  local partial_matches=()
  local roots=()

  query="$1"
  shift
  roots=("$@")
  query_lower=$(lowercase "$query")
  query_lower="${query_lower%.app}"

  RESOLVED_APP_PATH=""
  RESOLUTION_MATCHES=()

  [ -n "$query_lower" ] || return 1

  while IFS= read -r app; do
    [ -n "$app" ] || continue
    app_name=$(basename "$app" .app)
    app_name_lower=$(lowercase "$app_name")

    if [ "$app_name_lower" = "$query_lower" ]; then
      exact_matches+=("$app")
    else
      case "$app_name_lower" in
        *"$query_lower"*) partial_matches+=("$app") ;;
      esac
    fi
  done < <(discover_applications "${roots[@]}")

  if [ ${#exact_matches[@]} -eq 1 ]; then
    RESOLVED_APP_PATH="${exact_matches[0]}"
    return 0
  fi

  if [ ${#exact_matches[@]} -gt 1 ]; then
    RESOLUTION_MATCHES=("${exact_matches[@]}")
    return 2
  fi

  if [ ${#partial_matches[@]} -eq 1 ]; then
    RESOLVED_APP_PATH="${partial_matches[0]}"
    return 0
  fi

  if [ ${#partial_matches[@]} -gt 1 ]; then
    RESOLUTION_MATCHES=("${partial_matches[@]}")
    return 2
  fi

  return 1
}

escape_regex() {
  printf "%s" "$1" | sed 's/[][\\.^$*+?(){}|]/\\&/g'
}

launchd_matches_plist() {
  local plist content escaped
  plist="$1"
  content=$(/usr/bin/plutil -p "$plist" 2> /dev/null) || return 1

  if printf "%s" "$content" | grep -F "$app_path" > /dev/null; then
    return 0
  fi

  for id in "${related_bundle_ids[@]}"; do
    escaped=$(escape_regex "$id")
    if printf "%s" "$content" | grep -Eq "(^|[^A-Za-z0-9])${escaped}([^A-Za-z0-9]|$)"; then
      return 0
    fi
  done

  return 1
}

print_usage() {
  print_info "Usage:"
  print_info "  uninstall"
  print_info "  uninstall --list"
  print_info "  uninstall [--dry-run] [--yes] [--verbose] /path/to/app.app"
  print_info "  uninstall [--dry-run] [--yes] [--verbose] app-name"
  print_info "  --list      List installed applications."
  print_info "  --dry-run   Show matches and summary without removing anything (default)."
  print_info "  --yes       Skip confirmation prompts and proceed."
  print_info "  --verbose   Show full running-process command lines."
  print_info ""
  print_info "With no arguments or --list, searches /Applications and ~/Applications."
  print_info "Names use a case-insensitive exact match, then one unique substring match."
  print_info "Ambiguous names fail without changes and list the matching full paths."
  print_info ""
  print_info "Examples:"
  print_info "  uninstall --list"
  print_info "  uninstall raycast"
  print_info "  uninstall --dry-run \"Visual Studio Code\""
  print_info "  uninstall /Applications/Raycast.app"
}

function main() {
  if [ $# -eq 0 ]; then
    print_installed_applications "${APPLICATION_ROOTS[@]}"
    return 0
  fi

  IFS=$'\n'

  dry_run=true
  auto_yes=false
  prompt_for_confirmation=true
  verbose=false
  list_requested=false
  seen_dry_run=false
  seen_yes=false
  app_path=""

  while [ $# -gt 0 ]; do
    case "$1" in
      --help|-h)
        print_usage
        return 0
        ;;
      --list)
        list_requested=true
        ;;
      --yes|-y)
        seen_yes=true
        auto_yes=true
        dry_run=false
        prompt_for_confirmation=false
        ;;
      --dry-run)
        seen_dry_run=true
        dry_run=true
        prompt_for_confirmation=false
        ;;
      --verbose|-v)
        verbose=true
        ;;
      --)
        shift
        break
        ;;
      -*)
        print_error "Unknown option: $1"
        print_usage
        return 1
        ;;
      *)
        if [ -z "$app_path" ]; then
          app_path="$1"
        else
          print_error "Unexpected argument: $1"
          print_usage
          return 1
        fi
        ;;
    esac
    shift
  done

  if [ -z "$app_path" ] && [ $# -gt 0 ]; then
    app_path="$1"
    shift
  fi

  if [ $# -gt 0 ]; then
    print_error "Unexpected arguments: $*"
    print_usage
    return 1
  fi

  if [ "$seen_yes" = true ] && [ "$seen_dry_run" = true ]; then
    print_error "Cannot combine --yes with --dry-run."
    return 1
  fi

  if [ "$list_requested" = true ]; then
    if [ -n "$app_path" ] || [ "$seen_yes" = true ] || [ "$seen_dry_run" = true ] || [ "$verbose" = true ]; then
      print_error "Cannot combine --list with an app or uninstall options."
      return 1
    fi

    print_installed_applications "${APPLICATION_ROOTS[@]}"
    return 0
  fi

  if [ -z "$app_path" ]; then
    print_error "Missing app path."
    print_usage
    return 1
  fi

  app_path="${app_path%/}"
  if [ -z "$app_path" ]; then
    print_error "Invalid app path."
    return 1
  fi

  case "$app_path" in
    */*)
      if [ ! -e "$app_path/Contents/Info.plist" ]; then
        print_error "Cannot find app plist."
        return 1
      fi
      ;;
    *)
      resolve_application "$app_path" "${APPLICATION_ROOTS[@]}"
      resolution_status=$?
      if [ "$resolution_status" -eq 0 ]; then
        print_info "Resolved \"$app_path\" to \"$RESOLVED_APP_PATH\"."
        app_path="$RESOLVED_APP_PATH"
      elif [ "$resolution_status" -eq 2 ]; then
        print_error "Multiple applications matched \"$app_path\":"
        for match in "${RESOLUTION_MATCHES[@]}"; do
          printf "%s\n" "$match"
        done
        print_info "Run uninstall again with one full application path."
        return 1
      else
        print_error "No installed application matched \"$app_path\"."
        print_info "Run uninstall --list to see available applications."
        return 1
      fi
      ;;
  esac

  app_name=$(basename "$app_path" .app)
  success=true
  processes_found=0
  processes_killed=0
  receipt_logs_saved=0
  receipt_logs_matched=0
  paths_matched=0
  trash_action="skipped"
  trash_count=0
  kill_action="skipped"
  receipt_logs_action="skipped"
  confirmation_result="pending"
  launch_items_matched=0
  launch_items_unloaded=0
  launch_items_failed=0
  launch_action="skipped"

  if [ ! -e "$app_path/Contents/Info.plist" ]; then
    print_error "Cannot find app plist."
    return 1
  fi

  bundle_identifier=$(/usr/libexec/PlistBuddy -c "Print CFBundleIdentifier" "$app_path/Contents/Info.plist" 2> /dev/null)

  if [ "$bundle_identifier" = "" ]; then
    print_error "Cannot find app bundle identifier."
    return 1
  fi

  related_bundle_ids=("$bundle_identifier")
  while IFS= read -r -d '' plist; do
    nested_id=$(/usr/libexec/PlistBuddy -c "Print CFBundleIdentifier" "$plist" 2> /dev/null)
    if [ -n "$nested_id" ]; then
      case "$nested_id" in
        "$bundle_identifier"*) related_bundle_ids+=("$nested_id") ;;
      esac
    fi
  done < <(find "$app_path" \( -path "*.app/Contents/Info.plist" -o -path "*.xpc/Contents/Info.plist" -o -path "*.appex/Contents/Info.plist" \) -print0)
  related_bundle_ids=($(printf "%s\n" "${related_bundle_ids[@]}" | sort -u))

  print_info "Checking for running processes…"
  sleep 1

  raw_processes=($(pgrep -afil "$app_name" | grep -v "uninstall"))
  processes=()
  for process in "${raw_processes[@]}"; do
    pid=${process%% *}
    cmdline=${process#* }
    case "$cmdline" in
      "$app_path"/Contents/*) processes+=("$process") ;;
    esac
  done
  processes_found=${#processes[@]}

  receipt_paths=()

  receipt_paths+=($(find /private/var/db/receipts -iname "*$app_name*.bom" -maxdepth 1 -prune 2>&1 | grep -v "Permission denied"))
  receipt_paths+=($(find /private/var/db/receipts -iname "*$bundle_identifier*.bom" -maxdepth 1 -prune 2>&1 | grep -v "Permission denied"))

  receipt_logs_matched=${#receipt_paths[@]}

  print_info "Finding app data…"
  sleep 1

  bundle_paths=()
  name_paths=()
  launch_paths=()

  add_bundle_path() { [ -e "$1" ] && bundle_paths+=("$1"); }
  add_name_path() { [ -e "$1" ] && name_paths+=("$1"); }

  user_cache_dir=$(getconf DARWIN_USER_CACHE_DIR | sed "s/\/$//")
  user_temp_dir=$(getconf DARWIN_USER_TEMP_DIR | sed "s/\/$//")

  for id in "${related_bundle_ids[@]}"; do
    add_bundle_path "$HOME/Library/Application Scripts/$id"
    add_bundle_path "$HOME/Library/Containers/$id"
    add_bundle_path "$HOME/Library/Group Containers/group.$id"
    add_bundle_path "$HOME/Library/HTTPStorages/$id"
    add_bundle_path "$HOME/Library/Preferences/$id.plist"
    for path in "$HOME/Library/Preferences/ByHost/${id}".*.plist; do
      [ -e "$path" ] && bundle_paths+=("$path")
    done
    add_bundle_path "$HOME/Library/Saved Application State/$id.savedState"
    add_bundle_path "$HOME/Library/WebKit/$id"
    add_bundle_path "$HOME/Library/Logs/$id"
    add_bundle_path "$HOME/Library/Caches/$id"
    add_bundle_path "$HOME/Library/Application Support/$id"
    add_bundle_path "$HOME/Library/Application Support/CrashReporter/$id"

    add_bundle_path "/Library/Application Support/$id"
    add_bundle_path "/Library/Application Support/CrashReporter/$id"
    add_bundle_path "/Library/Caches/$id"
    add_bundle_path "/Library/Logs/$id"
    add_bundle_path "/Library/Preferences/$id.plist"
    add_bundle_path "/Library/PrivilegedHelperTools/$id"

    if [ -n "$user_cache_dir" ]; then
      add_bundle_path "$user_cache_dir/$id"
    fi
    if [ -n "$user_temp_dir" ]; then
      add_bundle_path "$user_temp_dir/$id"
    fi
  done

  add_name_path "$HOME/Library/Application Support/$app_name"
  add_name_path "$HOME/Library/Application Support/CrashReporter/$app_name"
  add_name_path "$HOME/Library/Caches/$app_name"
  add_name_path "$HOME/Library/Logs/$app_name"
  add_name_path "$HOME/Library/Saved Application State/$app_name.savedState"

  add_name_path "/Library/Application Support/$app_name"
  add_name_path "/Library/Application Support/CrashReporter/$app_name"
  add_name_path "/Library/Caches/$app_name"
  add_name_path "/Library/Logs/$app_name"

  for dir in "$HOME/Library/LaunchAgents" "/Library/LaunchAgents" "/Library/LaunchDaemons"; do
    [ -d "$dir" ] || continue
    for plist in "$dir"/*.plist; do
      [ -e "$plist" ] || continue
      if launchd_matches_plist "$plist"; then
        launch_paths+=("$plist")
      fi
    done
  done

  bundle_paths=($(printf "%s\n" "${bundle_paths[@]}" | sort -u))
  name_paths=($(printf "%s\n" "${name_paths[@]}" | sort -u))
  launch_paths=($(printf "%s\n" "${launch_paths[@]}" | sort -u))

  paths=("$app_path" "${bundle_paths[@]}" "${name_paths[@]}" "${launch_paths[@]}")
  paths=($(printf "%s\n" "${paths[@]}" | sort -u));
  paths_matched=${#paths[@]}
  launch_items_matched=${#launch_paths[@]}

  print_header "Preflight summary"
  print_info "App: $app_name"
  print_info "Bundle ID: $bundle_identifier"
  print_info "App path: $app_path"
  if [ "$seen_dry_run" = true ]; then
    print_info "Mode: dry run"
  elif [ "$auto_yes" = true ]; then
    print_info "Mode: auto-yes"
  else
    print_info "Mode: dry run until confirmed"
  fi

  print_header "Running processes"
  if [ ${#processes[@]} -gt 0 ]; then
    if [ "$verbose" = true ]; then
      for process in "${processes[@]}"; do
        printf "%s\n" "$process"
      done
    else
      for process in "${processes[@]}"; do
        pid=$(printf "%s" "$process" | awk '{print $1}')
        comm=$(ps -p "$pid" -o comm= 2> /dev/null | sed 's#.*/##')
        if [ -z "$comm" ]; then
          comm=$(printf "%s" "$process" | awk '{print $2}')
        fi
        if [ -n "$pid" ] && [ -n "$comm" ]; then
          printf "%s %s\n" "$pid" "$comm"
        elif [ -n "$pid" ]; then
          printf "%s\n" "$pid"
        else
          printf "%s\n" "$process"
        fi
      done
      print_info "Use --verbose for full command lines."
    fi
  else
    print_warn "None found."
  fi

  print_header "Launch items"
  if [ ${#launch_paths[@]} -gt 0 ]; then
    print_info "Launch items matched: ${#launch_paths[@]}"
    for path in "${launch_paths[@]}"; do
      printf "%s\n" "$path"
    done
  else
    print_warn "No launch items found."
  fi

  print_header "Matched paths"
  print_info "App bundle:"
  printf "%s\n" "$app_path"

  print_info "Bundle ID matches: ${#bundle_paths[@]}"
  if [ ${#bundle_paths[@]} -gt 0 ]; then
    for path in "${bundle_paths[@]}"; do
      printf "%s\n" "$path"
    done
  else
    print_warn "No bundle ID matches found."
  fi

  if [ ${#name_paths[@]} -gt 0 ]; then
    print_warn "App name matches (review): ${#name_paths[@]}"
    for path in "${name_paths[@]}"; do
      printf "%s\n" "$path"
    done
  else
    print_info "App name matches: 0"
  fi

  print_info "Total matched: ${#paths[@]}"

  print_header "Receipts"
  if [ ${#receipt_paths[@]} -gt 0 ]; then
    print_info "Receipt BOMs matched: ${#receipt_paths[@]}"
    for path in "${receipt_paths[@]}"; do
      printf "%s\n" "$path"
    done
  else
    print_warn "No receipt BOMs found."
  fi

  print_header "Planned actions"
  if [ "$auto_yes" = true ]; then
    print_warn "Proceeding without prompts (--yes)."
  elif [ "$seen_dry_run" = true ]; then
    print_warn "Dry run: no changes will be made."
  else
    print_info "Dry run default; you'll be asked to confirm before changes."
  fi
  if [ ${#paths[@]} -gt 0 ]; then
    print_info "Move matched paths to Trash on confirmation."
  else
    print_warn "No matched paths to move."
  fi
  if [ ${#launch_paths[@]} -gt 0 ]; then
    print_info "Unload launch items and move their plists to Trash on confirmation."
    print_warn "Unloading launch items may prompt for sudo."
  fi
  if [ ${#receipt_paths[@]} -gt 0 ]; then
    print_info "Save receipt logs to Desktop on confirmation."
  fi
  if [ ${#processes[@]} -gt 0 ]; then
    print_info "Attempt to quit the app before terminating remaining processes."
    print_warn "Running processes will be terminated after confirmation (may prompt for sudo)."
  fi

  proceed=false
  if [ "$auto_yes" = true ]; then
    proceed=true
    confirmation_result="auto-yes"
    dry_run=false
  elif [ "$prompt_for_confirmation" = true ]; then
    print_prompt "Proceed with uninstall (y or n)? "
    read -r answer
    if [ "$answer" = "y" ]; then
      proceed=true
      confirmation_result="confirmed"
      dry_run=false
    else
      proceed=false
      confirmation_result="declined"
      dry_run=true
    fi
  else
    proceed=false
    confirmation_result="dry-run"
  fi

  if [ "$proceed" = false ]; then
    if [ "$confirmation_result" = "declined" ]; then
      print_warn "Uninstall cancelled by user."
    else
      print_warn "Dry run: no changes made."
    fi
  fi

  if [ "$proceed" = true ]; then
    if [ ${#processes[@]} -gt 0 ]; then
      print_info "Attempting to quit app…"
      osascript -e "tell application id \"$bundle_identifier\" to quit" > /dev/null 2>&1
      sleep 2

      raw_processes=($(pgrep -afil "$app_name" | grep -v "uninstall"))
      kill_processes=()
      for process in "${raw_processes[@]}"; do
        pid=${process%% *}
        cmdline=${process#* }
        case "$cmdline" in
          "$app_path"/Contents/*) kill_processes+=("$process") ;;
        esac
      done

      if [ ${#kill_processes[@]} -gt 0 ]; then
        kill_action="killed"
        print_info "Killing running processes…"
        sleep 1
        for process in "${kill_processes[@]}"; do
          pid=$(printf "%s" "$process" | awk '{print $1}')
          if [ -n "$pid" ]; then
            sudo kill "$pid" 2>&1 | grep -v "No such process"
            processes_killed=$((processes_killed + 1))
          fi
        done
      else
        kill_action="quit"
      fi
    else
      kill_action="none"
    fi

    if [ ${#receipt_paths[@]} -gt 0 ]; then
      print_info "Saving bill of material logs to desktop…"
      sleep 1
      for path in "${receipt_paths[@]}"; do
        mkdir -p "$HOME/Desktop/$app_name"
        if lsbom -f -l -s -p f "$path" > "$HOME/Desktop/$app_name/$(basename "$path").log"; then
          receipt_logs_saved=$((receipt_logs_saved + 1))
        fi
      done
      receipt_logs_action="saved"
    else
      receipt_logs_action="none"
    fi

    if [ ${#launch_paths[@]} -gt 0 ]; then
      print_info "Unloading launch items…"
      for plist in "${launch_paths[@]}"; do
        if [[ "$plist" == "/Library/LaunchDaemons/"* ]]; then
          if sudo launchctl bootout system "$plist" > /dev/null 2>&1; then
            launch_items_unloaded=$((launch_items_unloaded + 1))
          else
            launch_items_failed=$((launch_items_failed + 1))
          fi
        else
          if launchctl bootout "gui/$UID" "$plist" > /dev/null 2>&1; then
            launch_items_unloaded=$((launch_items_unloaded + 1))
          elif sudo launchctl bootout "gui/$UID" "$plist" > /dev/null 2>&1; then
            launch_items_unloaded=$((launch_items_unloaded + 1))
          else
            launch_items_failed=$((launch_items_failed + 1))
          fi
        fi
      done
      if [ "$launch_items_failed" -gt 0 ]; then
        launch_action="partial"
      else
        launch_action="unloaded"
      fi
    else
      launch_action="none"
    fi

    if [ ${#paths[@]} -gt 0 ]; then
      print_info "Moving app data to trash…"
      sleep 1
      posixFiles=$(printf ", POSIX file \"%s\"" "${paths[@]}" | awk '{print substr($0,3)}')
      if osascript -e "tell application \"Finder\" to delete { $posixFiles }" > /dev/null; then
        trash_action="moved"
        trash_count=${#paths[@]}
      else
        trash_action="failed"
        success=false
        print_error "Move to Trash failed. Check Finder permissions."
      fi
    else
      trash_action="skipped (no matches)"
    fi
  else
    if [ "$confirmation_result" = "declined" ]; then
      kill_action="skipped (not confirmed)"
      receipt_logs_action="skipped (not confirmed)"
      trash_action="skipped (not confirmed)"
      launch_action="skipped (not confirmed)"
    else
      kill_action="skipped (dry run)"
      receipt_logs_action="skipped (dry run)"
      trash_action="skipped (dry run)"
      launch_action="skipped (dry run)"
    fi
  fi

  if [ "$processes_found" -eq 0 ]; then
    kill_action="none"
  fi
  if [ "$receipt_logs_matched" -eq 0 ]; then
    receipt_logs_action="none"
  fi
  if [ "$launch_items_matched" -eq 0 ]; then
    launch_action="none"
  fi
  if [ "$paths_matched" -eq 0 ]; then
    trash_action="skipped (no matches)"
    trash_count=0
  fi

  print_header "Summary report"
  print_info "App: $app_name"
  print_info "Bundle ID: $bundle_identifier"
  print_info "Confirmation: $confirmation_result"
  print_info "Processes found: $processes_found"
  print_info "Processes killed: $processes_killed ($kill_action)"
  print_info "Receipt logs: $receipt_logs_saved/$receipt_logs_matched ($receipt_logs_action)"
  print_info "Launch items: $launch_items_matched ($launch_action, unloaded: $launch_items_unloaded, failed: $launch_items_failed)"
  print_info "Paths matched: $paths_matched"
  print_info "Trash action: $trash_action ($trash_count)"

  if [ "$success" = true ]; then
    print_success "Done"
  else
    return 1
  fi
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  main "$@"
fi
